<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (target SDK 30+): without this, TextToSpeech can't see or bind
         to any installed TTS engine, so init fails and getVoices() is empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- AppCompatActivity throws "You need to use a Theme.AppCompat theme" without one,
         which was the first-launch crash. Material 3 DayNight (light/dark follows the system;
         dynamic color is applied in ArklectorApplication). NoActionBar: the UI draws its own top bar.
         Library style reference only - no styles.xml of our own (design.md). -->
    <application
        android:name="ARKlector.ArklectorApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        android:allowBackup="true">

        <activity
            android:name="ARKlector.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name="ARKlector.service.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
